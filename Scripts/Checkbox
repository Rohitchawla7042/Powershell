Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.drawing

$form = New-Object System.Windows.Forms.Form -Property @{
    Text = 'Data Entry Form'
    Size = New-Object System.Drawing.Size(300,200)
    StartPosition = 'CenterScreen'
}

$okbutton = New-Object System.Windows.Forms.Button -Property @{
    Text = 'OK'
    Location = New-Object System.Drawing.Point(100,200)
    size = New-Object System.Drawing.Point(75,85)
    DialogResult = New-Object [System.Windows.Forms.DialogResult]::OK
  
}
 $form.AcceptButton = $okbutton
 $form.Controls.Add($okbutton)

 $cancelbutton = New-Object System.Windows.Forms.Button -Property @{
    Text = 'Cancel'
    Location = New-Object System.Drawing.Point(100,200)
    size = New-Object System.Drawing.Point(20,50)
    DialogResult = New-Object ([System.Windows.Forms.DialogResult]::Cancel)
}

$form.AcceptButton = $cancelbutton
$form.Controls.Add($cancelbutton)



$label = New-Object System.Windows.Forms.Label -Property @{
    location = New-Object System.Drawing.Point(100,200)
    size = New-Object System.Drawing.Point(75,85)
    text = 'Please make a selection from the list below:-'

}

$form.Controls.Add($label)

$listbox = New-Object System.Windows.Forms.ListBox -Property @{
    location = New-Object System.Drawing.Point(85,75)
    size = New-Object System.Drawing.Point(100,75)
    $listbox.selectionmode = 'MultiExtended'
}

    [void] $listbox.Items.add('Item1')
    [void] $listbox.Items.add('Item2')
    [void] $listbox.Items.add('Item3')
    [void] $listbox.Items.add('Item4')

$listbox.Height = 70
$form.Controls.Add($listbox)
$form.TopMost = $true


$result = $form.ShowDialog()

if (result -eq [System.Windows.Forms.DialogResult]::OK] {
    $x = $listbox.SelectedItems
    $x
}


